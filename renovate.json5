{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>sironheart/home-cluster//.renovate/customDataSources.json5",
    "github>sironheart/home-cluster//.renovate/customManagers.json5",
    "github>sironheart/home-cluster//.renovate/groups.json5",
    "github>sironheart/home-cluster//.renovate/labels.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Berlin)"
  ],
  flux: {
    managerFilePatterns: ["/(^|/)k8s/.+\\.ya?ml$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)k8s/.+\\.ya?ml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)k8s/.+\\.ya?ml$/"],
  },
}
