{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "local>home-operations/renovate-presets",
    "local>home-operations/renovate-presets//apps/cnpg.json5",
    "local>home-operations/renovate-presets//apps/talosFactory.json5",
    "local>home-operations/renovate-presets//apps/grafanaDashboards.json5",
    "local>home-operations/renovate-presets//apps/phanpy.json5",
    ":semanticCommits",
    ":timezone(Europe/Berlin)",
  ],
  flux: {
    registryAliases: {
      rocm: "https://rocm.github.io/gpu-operator",
    },
  },
  hostRules: [
    {
      matchHost: "git.erwanleboucher.dev",
      hostType: "forgejo",
    },
    {
      matchHost: "git.ow-ops.eu",
      hostType: "forgejo",
    },
  ],
  packageRules: [
    {
      // Keep the name in the Helmfile for update verification; packageName still uses Docker Hub.
      description: "Preserve the mirrored Envoy Helmfile dependency name",
      matchManagers: ["helmfile"],
      matchPackageNames: ["docker.io/envoyproxy/gateway-helm"],
      overrideDepName: "mirror.gcr.io/envoyproxy/gateway-helm",
    },
    {
      description: "Keep VectorChord images compatible with the PostgreSQL major",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tensorchord/vchord-scratch"],
      versioning: "regex:^(?:(?<compatibility>pg\\d+)-v)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      // config:best-practices (via RENOVATE_EXTENDS) enables docker:pinDigests /
      // action digest pins; those break renovate/pin-dependencies for OCI charts
      // and regex version annotations. Skip pinning in this repo.
      description: "Disable dependency pinning",
      matchUpdateTypes: ["pin", "pinDigest"],
      enabled: false,
    },
    {
      description: "Disable digest pinning",
      matchPackageNames: ["*"],
      pinDigests: false,
    },
    {
      description: "Auto merge minors and patches after minimumReleaseAge",
      matchDatasources: ["docker"],
      schedule: ["* 2 * * *"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: [
        "renovate/renovate",
        "ghcr.io/stakater/charts/reloader",
        "ghcr.io/emberstack/helm-charts/reflector",
      ],
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "1Password Connect group",
      groupName: "1Password Connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["/1password/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "Flux Operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Kubernetes Group",
      groupName: "Kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Rook-Ceph Group",
      groupName: "Rook-Ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Talos group",
      groupName: "Talos",
      matchDatasources: ["docker"],
      matchPackageNames: ["/installer/", "/talosctl/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
  ],
}
